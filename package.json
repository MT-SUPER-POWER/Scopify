{
  "name": "scopify-workspace",
  "version": "2.0.1",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=@scopify/web --filter=@scopify/desktop",
    "dev:web": "turbo run dev --filter=@scopify/web",
    "dev:docs": "turbo run dev --filter=@scopify/docs",
    "dev:desktop": "turbo run dev --filter=@scopify/desktop",
    "dev:backend": "node repo/backend/api-enhanced/app.js",
    "dev:full": "concurrently -n \"CLIENTS,NETEASE\" -c \"yellow,red\" --kill-others \"pnpm run dev\" \"pnpm run dev:backend\"",
    "prototype:desktop-wallpaper": "bun scripts/run-desktop-wallpaper-spike.ts",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@scopify/web",
    "build:docs": "turbo run build --filter=@scopify/docs",
    "start:web": "pnpm --filter @scopify/web start",
    "start:docs": "pnpm --filter @scopify/docs start",
    "deploy:web": "vercel deploy --prod --project scopify-web",
    "deploy:web:preview": "vercel deploy --project scopify-web",
    "deploy:docs": "vercel deploy --prod --project scopify-docs",
    "deploy:docs:preview": "vercel deploy --project scopify-docs",
    "sync:renderer": "turbo run sync:renderer --filter=@scopify/desktop",
    "build:desktop": "turbo run build --filter=@scopify/desktop",
    "package:win": "turbo run package:win --filter=@scopify/desktop",
    "package:mac": "turbo run package:mac --filter=@scopify/desktop",
    "release:win": "turbo run release:win --filter=@scopify/desktop",
    "release:mac": "turbo run release:mac --filter=@scopify/desktop",
    "build:win": "turbo run build:win --filter=@scopify/desktop",
    "build:mac": "turbo run build:mac --filter=@scopify/desktop",
    "typecheck": "turbo run typecheck",
    "test:architecture": "bun test scripts/check-architecture.test.ts",
    "test": "pnpm run test:architecture",
    "lint:architecture": "bun scripts/check-architecture.ts",
    "lint": "pnpm run lint:architecture && turbo run lint --filter=\"@scopify/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:types": "pnpm --dir repo/frontend/apps/web run i18n:types",
    "i18n:audit": "pnpm --dir repo/frontend/apps/web run i18n:audit"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-markdown-compact-tables": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.6",
    "typescript": "^5.9.3"
  }
}
