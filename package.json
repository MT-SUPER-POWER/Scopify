{
  "name": "scopify-workspace",
  "version": "1.2.0-beta.2",
  "private": true,
  "packageManager": "bun@1.3.7",
  "workspaces": [
    "frontend/apps/*",
    "frontend/packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev --filter=@scopify/web --filter=@scopify/desktop --parallel",
    "dev:web": "turbo run dev --filter=@scopify/web",
    "dev:desktop": "turbo run dev --filter=@scopify/desktop",
    "dev:backend": "bun run backend/api-enhanced/app.js",
    "dev:full": "concurrently -n \"CLIENTS,NETEASE\" -c \"yellow,red\" --kill-others \"bun run dev\" \"bun run dev:backend\"",
    "build": "bun run build:web && bun run build:desktop",
    "build:web": "turbo run build --filter=@scopify/web",
    "build:desktop-renderer": "turbo run build:desktop --filter=@scopify/web && bun frontend/apps/desktop/scripts/sync-renderer.ts",
    "build:desktop": "bun run build:desktop-renderer && turbo run build --filter=@scopify/desktop",
    "build:win": "bun run build:desktop && bun run --cwd frontend/apps/desktop package:win",
    "build:mac": "bun run build:desktop && bun run --cwd frontend/apps/desktop package:mac",
    "release:win": "bun run build:desktop && bun run --cwd frontend/apps/desktop release:win",
    "release:mac": "bun run build:desktop && bun run --cwd frontend/apps/desktop release:mac",
    "typecheck": "turbo run typecheck",
    "test:architecture": "bun test scripts/check-architecture.test.ts",
    "test": "bun run test:architecture && turbo run test",
    "lint:architecture": "bun scripts/check-architecture.ts",
    "lint": "bun run lint:architecture && turbo run lint",
    "format": "prettier --write .",
    "i18n:types": "bun run --cwd frontend/apps/web i18n:types",
    "i18n:audit": "bun run --cwd frontend/apps/web i18n:audit"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx}": [
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,yml}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "sharp",
    "unrs-resolver"
  ]
}
