{
  "name": "scopify-workspace",
  "version": "4.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "prepare": "husky",
    "bump": "bun scripts/bump-version.ts",
    "changelog:preview": "git-cliff --unreleased --strip all",
    "skills": "bun scripts/link-skills.ts",
    "i18n:ui": "x18n ui",
    "dev": "turbo run dev --filter=@scopify/web --filter=@scopify/desktop",
    "dev:web": "turbo run dev --filter=@scopify/web",
    "dev:docs": "turbo run dev --filter=@scopify/docs",
    "dev:desktop": "turbo run dev --filter=@scopify/desktop",
    "dev:backend:ncm": "bun --no-env-file scripts/dev-backend-ncm.ts",
    "dev:backend:qq": "bun --no-env-file scripts/dev-backend-qq.ts",
    "dev:backend:all": "concurrently -n \"NETEASE,QQ\" -c \"red,green\" --kill-others \"pnpm run dev:backend:ncm\" \"pnpm run dev:backend:qq\"",
    "dev:full": "concurrently -n \"CLIENTS,NETEASE,QQ\" -c \"yellow,red,green\" --kill-others \"pnpm run dev\" \"pnpm run dev:backend:ncm\" \"pnpm run dev:backend:qq\"",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@scopify/web",
    "build:docs": "turbo run build --filter=@scopify/docs",
    "start:web": "pnpm --filter @scopify/web start",
    "start:docs": "pnpm --filter @scopify/docs start",
    "deploy:web": "vercel deploy --prod --project scopify-web",
    "deploy:web:preview": "vercel deploy --project scopify-web",
    "deploy:docs": "vercel deploy --prod --project scopify-docs",
    "deploy:docs:preview": "vercel deploy --project scopify-docs",
    "sync:renderer": "turbo run sync:renderer --filter=@scopify/desktop",
    "build:desktop": "turbo run build --filter=@scopify/desktop",
    "package:win": "turbo run package:win --filter=@scopify/desktop",
    "package:mac": "turbo run package:mac --filter=@scopify/desktop",
    "build:win": "turbo run package:win --filter=@scopify/desktop",
    "build:mac": "turbo run package:mac --filter=@scopify/desktop",
    "check": "pnpm run check:format && pnpm run check:architecture && pnpm run check:packages && pnpm run check:i18n",
    "check:format": "prettier --check .",
    "check:architecture": "bun scripts/check-architecture.ts",
    "check:packages": "bun scripts/check-package-quality.ts",
    "check:i18n": "x18n check --strict",
    "check:types": "turbo run typecheck",
    "typecheck": "turbo run typecheck",
    "lint:packages": "bun scripts/check-package-quality.ts",
    "test:packages": "turbo run test --filter=\"./repo/frontend/packages/*\"",
    "test:architecture": "bun test scripts/test/check-architecture.test.ts",
    "test": "bun test scripts/test",
    "lint:architecture": "bun scripts/check-architecture.ts",
    "lint:i18n": "x18n check --strict",
    "lint:staged": "lint-staged",
    "lint": "turbo run lint --filter=\"@scopify/*\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@x18n/cli": "^0.1.14",
    "concurrently": "^9.2.4",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.9.9",
    "prettier-plugin-markdown-compact-tables": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
