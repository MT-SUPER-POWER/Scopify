{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "globalEnv": [
    "APP_CFG_*",
    "BACKEND_*",
    "FRONTEND_*",
    "NEXT_DIST_DIR",
    "NEXT_TELEMETRY_DISABLED",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE_STATE_DIR",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE_SYSTEM_FALLBACK",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE_TRANSPARENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**", "build/**"]
    },
    "build:desktop": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "build:host": {
      "dependsOn": ["^build"],
      "outputs": ["build/desktop/app/out/**"]
    },
    "sync:renderer": {
      "dependsOn": ["@scopify/web#build:desktop"],
      "cache": false
    },
    "@scopify/desktop#build": {
      "dependsOn": ["sync:renderer", "^build"],
      "outputs": ["build/desktop/app/out/**"]
    },
    "build:win": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build:mac": {
      "dependsOn": ["build"],
      "cache": false
    },
    "package:win": {
      "cache": false
    },
    "package:mac": {
      "cache": false
    },
    "release:win": {
      "dependsOn": ["build"],
      "cache": false
    },
    "release:mac": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
