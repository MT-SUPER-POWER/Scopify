{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "cacheMaxSize": "2GB",
  "cacheMaxAge": "7d",
  "globalPassThroughEnv": [
    "GITHUB_SHA",
    "VERCEL_GIT_COMMIT_SHA",
    "SCOPIFY_RELEASE_NOTES_STRICT",
    "APP_CFG_*",
    "BACKEND_*",
    "FRONTEND_*",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@scopify/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/docs/CHANGELOG.md"],
      "env": [
        "SCOPIFY_BUILD_TARGET",
        "SCOPIFY_RELEASE_NOTES_STRICT",
        "APP_CFG_*",
        "BACKEND_*",
        "FRONTEND_*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@scopify/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".source/**"]
    },
    "@scopify/web#build:desktop": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/docs/CHANGELOG.md"],
      "env": [
        "SCOPIFY_BUILD_TARGET",
        "SCOPIFY_RELEASE_NOTES_STRICT",
        "APP_CFG_*",
        "BACKEND_*",
        "FRONTEND_*"
      ],
      "outputs": ["out/**", "!out/cache/**", "!out/dev/**"]
    },
    "build:host": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "sync:renderer": {
      "dependsOn": ["@scopify/web#build:desktop"],
      "cache": false
    },
    "@scopify/desktop#build": {
      "dependsOn": ["sync:renderer", "^build"],
      "cache": false
    },
    "package:win": {
      "cache": false
    },
    "package:mac": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/repo/frontend/packages/eslint.config.mjs"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
