{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "globalEnv": [
    "APP_CFG_*",
    "BACKEND_*",
    "FRONTEND_*",
    "NEXT_DIST_DIR",
    "NEXT_TELEMETRY_DISABLED",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE_STATE_DIR",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE_SYSTEM_FALLBACK",
    "SCOPIFY_DESKTOP_WALLPAPER_SPIKE_TRANSPARENT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "build:desktop": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
