{
  "$schema": "https://v2-10-12.turborepo.dev/schema.json",
  "globalDependencies": ["docs/CHANGELOG.md"],
  "globalEnv": [
    "GITHUB_SHA",
    "VERCEL_GIT_COMMIT_SHA",
    "SCOPIFY_RELEASE_NOTES_STRICT",
    "APP_CFG_*",
    "BACKEND_*",
    "FRONTEND_*",
    "NEXT_DIST_DIR",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**", "build/**"]
    },
    "build:desktop": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "build:host": {
      "dependsOn": ["^build"],
      "outputs": ["build/desktop/app/out/**"]
    },
    "sync:renderer": {
      "dependsOn": ["@scopify/web#build:desktop"],
      "cache": false
    },
    "@scopify/desktop#build": {
      "dependsOn": ["sync:renderer", "^build"],
      "outputs": ["build/desktop/app/out/**"]
    },
    "package:win": {
      "cache": false
    },
    "package:mac": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
