{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "cacheMaxSize": "2GB",
  "cacheMaxAge": "7d",
  "globalPassThroughEnv": [
    "GITHUB_SHA",
    "VERCEL_GIT_COMMIT_SHA",
    "SCOPIFY_RELEASE_NOTES_STRICT",
    "APP_CFG_*",
    "BACKEND_*",
    "FRONTEND_*",
    "NEXT_TELEMETRY_DISABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@scopify/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/docs/CHANGELOG.md"],
      "env": [
        "SCOPIFY_BUILD_TARGET",
        "SCOPIFY_RELEASE_NOTES_STRICT",
        "APP_CFG_*",
        "BACKEND_*",
        "FRONTEND_*"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@scopify/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".source/**"]
    },
    "@scopify/web#build:desktop": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/docs/CHANGELOG.md"],
      "env": [
        "SCOPIFY_BUILD_TARGET",
        "SCOPIFY_RELEASE_NOTES_STRICT",
        "APP_CFG_*",
        "BACKEND_*",
        "FRONTEND_*"
      ],
      "outputs": ["out/**", "!out/cache/**", "!out/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint:staged": {
      "dependsOn": ["//#lint:architecture"],
      "passThroughEnv": ["GIT_*"],
      "cache": false
    },
    "//#lint:architecture": {
      "cache": false
    },
    "//#lint:packages": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint", "//#lint:architecture", "//#lint:packages"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/repo/frontend/packages/eslint.config.mjs"]
    },
    "@scopify/web#lint": {
      "dependsOn": ["^lint", "//#lint:architecture", "//#lint:packages"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/repo/frontend/packages/eslint.config.mjs"]
    },
    "@scopify/desktop#lint": {
      "dependsOn": [
        "//#lint:architecture",
        "//#lint:packages",
        "@scopify/desktop-contract#lint",
        "@scopify/notification-core#lint"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck:transit": {
      "dependsOn": ["^typecheck:transit"]
    },
    "typecheck": {
      "dependsOn": ["typecheck:transit"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "@scopify/docs#typecheck": {
      "dependsOn": ["typecheck:transit", "@scopify/web#typecheck:transit"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    }
  }
}
