{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun", "node", "electron"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "main/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "out", "renderer"]
}
