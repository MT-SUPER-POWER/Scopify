# Backend endpoint exposed to the browser.
BACKEND_PUBLIC_PROTOCOL=http
BACKEND_PUBLIC_HOST=127.0.0.1
BACKEND_PUBLIC_PORT=3838

# Local Next.js development server.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000

# Optional renderer log relay settings used during local development.
APP_CFG_DEBUG_LOG_RELAY_HOST=127.0.0.1
APP_CFG_DEBUG_LOG_RELAY_PORT=3001
APP_CFG_LOG_KEEP_DAYS=7
