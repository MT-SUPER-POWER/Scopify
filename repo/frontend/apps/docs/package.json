{
  "name": "@scopify/docs",
  "version": "1.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 3001",
    "generate:api": "bun scripts/generate-netease-schema.ts && bun scripts/generate-netease-api.ts",
    "build": "next build --webpack",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "@scopify/ui": "workspace:*",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "^15.2.3",
    "fumadocs-openapi": "^11.2.4",
    "fumadocs-ui": "16.14.3",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "lucide-react": "^1.26.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
