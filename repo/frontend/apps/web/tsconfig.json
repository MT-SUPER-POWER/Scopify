{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@scopify/desktop-contract": [
        "../../packages/desktop-contract/src/index.ts"
      ],
      "@scopify/playback-core": ["../../packages/playback-core/src/index.ts"],
      "@scopify/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@scopify/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@components/*": [
        "./components/*"
      ],
      "@store/*": [
        "./store/*"
      ],
      "@app-types/*": [
        "./types/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out"
  ]
}
