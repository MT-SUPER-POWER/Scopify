{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun", "node", "electron", "electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@main/*": ["./electron/main/*"],
      "@preload/*": ["./electron/preload/*"],
      "@scopify/audio-engine": ["native/audio-engine"],
      "@scopify/wallpaper-helper": ["native/wallpaper-helper"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "lib/**/*.ts",
    "electron/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "out", "renderer"]
}
