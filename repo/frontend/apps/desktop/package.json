{
  "name": "@scopify/desktop",
  "version": "3.1.3",
  "private": true,
  "description": "Scopify Electron desktop host",
  "author": {
    "name": "Momo",
    "email": "shuhengwen@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MT-SUPER-POWER/Scopify.git",
    "directory": "repo/frontend/apps/desktop"
  },
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "electron:ensure": "pnpm exec install-electron --no",
    "dev": "electron-vite dev --ignoreConfigWarning",
    "wallpaper:build": "bun scripts/build-wallpaper-helper.ts",
    "wallpaper:build:all": "bun scripts/build-wallpaper-helper.ts --all-arch",
    "wallpaper:verify": "bun scripts/verify-wallpaper-native.ts",
    "sync:renderer": "bun scripts/sync-renderer.ts",
    "audio:build": "bun scripts/build-audio-engine.ts",
    "audio:build:all": "bun scripts/build-audio-engine.ts --all-arch",
    "taskbar:build": "bun scripts/build-taskbar-lyric.ts",
    "taskbar:build:all": "bun scripts/build-taskbar-lyric.ts --all-arch",
    "build:host": "electron-vite build --ignoreConfigWarning",
    "prepare:app": "bun scripts/prepare-packaged-app.ts",
    "check:runtime-bundle": "bun scripts/check-runtime-bundle.ts",
    "check:runtime-bundle:prebuilt": "bun scripts/check-runtime-bundle.ts",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "test": "bun test",
    "package:win": "electron-builder --config electron-builder.config.ts --win --publish never",
    "package:win:prebuilt": "electron-builder --config electron-builder.config.ts --win --publish never",
    "package:mac": "electron-builder --config electron-builder.config.ts --mac --publish never",
    "package:mac:prebuilt": "electron-builder --config electron-builder.config.ts --mac --publish never"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/cli": "^3.8.2",
    "@scopify/desktop-contract": "workspace:*",
    "@scopify/notification-core": "workspace:*",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@xhayper/discord-rpc": "^1.3.4",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "js-yaml": "^4.3.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
