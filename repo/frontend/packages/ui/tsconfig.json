{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@scopify/ui/*": ["./*"]
    }
  },
  "include": ["folia/**/*.ts", "shadcn/**/*.ts", "shadcn/**/*.tsx", "tests/**/*.ts"]
}
