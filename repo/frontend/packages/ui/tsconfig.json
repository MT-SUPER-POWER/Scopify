{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "folia/**/*.ts",
    "scopify/**/*.ts",
    "scopify/**/*.tsx",
    "shadcn/**/*.ts",
    "shadcn/**/*.tsx",
    "tests/**/*.ts"
  ]
}
